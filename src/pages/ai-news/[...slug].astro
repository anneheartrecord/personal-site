---
import Layout from "../../layouts/Layout.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { getCollection, render } from "astro:content";
import { site } from "../../data/site";
import { getContentFileLastmod } from "../../lib/git-lastmod";

export async function getStaticPaths() {
  const issues = await getCollection("aiNews", ({ data }) => !data.draft);
  return issues.map((issue) => ({
    params: { slug: issue.id },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);
const lang = "zh-CN";
const publishedDate = issue.data.date.toISOString();
const canonicalPath = `/ai-news/${issue.id}`;
const canonicalUrl = new URL(canonicalPath, site.url).toString();
const imageUrl = new URL(site.image, site.url).toString();
// issue.id is lowercased by Astro's glob loader (githubSlug), but the file on disk keeps its
// original case, so rebuilding the path from issue.id silently mismatches git history for any
// issue whose filename has uppercase letters. issue.filePath preserves the real, case-correct,
// repo-root-relative path — use it instead.
const dateModified = getContentFileLastmod(issue.filePath ?? `src/content/ai-news/${issue.id}.md`, issue.data.date).toISOString();
const aiNewsIndexUrl = new URL("/ai-news", site.url).toString();
---

<Layout
  title={`${issue.data.title} — Charles Cheng`}
  description={issue.data.description}
  canonicalPath={canonicalPath}
  pageType="article"
  lang={lang}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: issue.data.title,
      description: issue.data.description,
      image: imageUrl,
      inLanguage: lang,
      datePublished: publishedDate,
      dateModified: dateModified,
      url: canonicalUrl,
      keywords: issue.data.tags,
      author: {
        "@type": "Person",
        name: site.author.name,
        alternateName: site.author.alias,
        url: site.url,
      },
      publisher: {
        "@type": "Person",
        name: site.author.name,
        alternateName: site.author.alias,
        url: site.url,
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: site.url },
        { "@type": "ListItem", position: 2, name: "AI News", item: aiNewsIndexUrl },
        { "@type": "ListItem", position: 3, name: issue.data.title, item: canonicalUrl },
      ],
    },
  ]}
>
  <article>
    <a href="/ai-news" class="inline-flex items-center text-xs font-medium mb-6 transition-opacity hover:opacity-70" style={`color: var(--text-tertiary);`}>
      ← Back to AI News
    </a>

    <header class="mb-8">
      <p class="text-[11px] font-semibold uppercase mb-3" style={`color: var(--text-tertiary); letter-spacing: 0;`}>
        Daily AI News
      </p>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3" style={`color: var(--text-primary);`}>
        {issue.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3">
        <time class="text-xs font-mono" style={`color: var(--text-tertiary);`}>
          {issue.data.date.toISOString().split("T")[0]}
        </time>
        <div class="flex flex-wrap gap-1.5">
          {issue.data.tags.map((tag: string) => <span class="tag-pill">{tag}</span>)}
          <span class="tag-pill">{issue.data.sourceCount} sources</span>
        </div>
      </div>
    </header>

    <div class="prose"><Content /></div>

    <div class="mt-12">
      <NewsletterSignup source={`ai-news-${issue.id}`} />
    </div>

    <div class="mt-12 pt-6" style={`border-top: 1px solid var(--border-color);`}>
      <a href="/ai-news" class="text-xs font-medium transition-opacity hover:opacity-70" style={`color: var(--color-accent);`}>← Back to AI News</a>
    </div>
  </article>
</Layout>
