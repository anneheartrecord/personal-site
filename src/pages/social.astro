---
import Layout from "../layouts/Layout.astro";
import { socials } from "../data/socials";
---

<Layout
  title="Social Media — Charles Cheng"
  description="Public social links and contact methods for Charles Cheng, including GitHub, X/Twitter, email, and WeChat."
  canonicalPath="/social"
>
  <h1 class="text-2xl font-bold tracking-tight mb-8" style={`color: var(--text-primary);`}>Social Media</h1>

  <div class="space-y-0 card overflow-hidden">
    {socials.map((social, i) => {
      const rowClass = "flex items-center justify-between px-5 py-4 transition-all duration-200 hover:bg-[var(--bg-tertiary)]";
      const rowStyle = `${i > 0 ? `border-top: 1px solid var(--border-color);` : ""} color: var(--text-primary);`;

      // WeChat has no URL to open — it triggers the QR modal rendered by Sidebar.astro
      return social.icon === "wechat" ? (
        <button class={`wechat-trigger w-full text-left cursor-pointer ${rowClass}`} style={rowStyle}>
          <span class="text-sm font-medium">{social.name}</span>
          <span class="text-xs font-medium" style={`color: var(--color-accent);`}>QR Code</span>
        </button>
      ) : (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class={rowClass}
          style={rowStyle}
        >
          <span class="text-sm font-medium">{social.name}</span>
          <span class="text-xs font-medium" style={`color: var(--color-accent);`}>Link →</span>
        </a>
      );
    })}
  </div>
</Layout>
