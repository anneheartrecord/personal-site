---
import Layout from "../layouts/Layout.astro";
import { bookshelf } from "../data/bookshelf";
import { site } from "../data/site";

const data = bookshelf;
// Book details (thoughts, highlights) load from /books/data.json when a dialog opens, keeping this page light.
const pageDescription =
  "Charles Cheng 的书房：微信读书阅读时长、阅读习惯，以及读过的书里划下的句子和当时写下的想法。";

const maxYear = Math.max(...data.years.map((y) => y.hours));
const maxMonth = Math.max(...data.months.map((m) => m.hours));
const peakMonth = data.months.reduce((a, b) => (b.hours > a.hours ? b : a));
const maxHour = Math.max(...data.hourly.map((h) => h.hours));
const peakHour = data.hourly.reduce((a, b) => (b.hours > a.hours ? b : a));
const maxCat = Math.max(...data.categories.map((c) => c.hours));
const currentYear = data.years[data.years.length - 1].year;
const firstMonthIdx = data.months.findIndex((m) => m.hours > 0);
const months = data.months.slice(firstMonthIdx);
const asOf = `${Number(data.generatedAt.slice(5, 7))} 月 ${Number(data.generatedAt.slice(8))} 日`;

// Reading-preference radar: the six categories with the most reading time, scaled to the largest.
const radarCats = data.categories.slice(0, 6);
const radarMax = Math.max(...radarCats.map((c) => c.hours));
const RADAR = { cx: 185, cy: 136, r: 84 };
const radarPoint = (i: number, frac: number) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / radarCats.length;
  return { x: RADAR.cx + frac * RADAR.r * Math.cos(a), y: RADAR.cy + frac * RADAR.r * Math.sin(a) };
};
const radarRing = (frac: number) =>
  radarCats.map((_, i) => radarPoint(i, frac)).map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
const radarVerts = radarCats.map((c, i) => ({ ...c, ...radarPoint(i, Math.max(c.hours / radarMax, 0.06)) }));
const radarLabels = radarCats.map((c, i) => {
  const p = radarPoint(i, 1.2);
  const anchor = Math.abs(p.x - RADAR.cx) < 4 ? "middle" : p.x > RADAR.cx ? "start" : "end";
  return { ...c, x: p.x, y: p.y, anchor };
});

// Knowledge map drawn as an old-style map: each domain is a landmass, each topic a city,
// and topics that share books are joined by roads (same domain) or sea routes (across domains).
// Layout is deterministic so the map never reshuffles between builds.
const seeded = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const MAP = { w: 1000, h: 800, colGap: 150, rowGap: 58 };
const mapDomains = data.domains.filter((d) => d.topics > 0);
// Two staggered rows of landmasses: the top row takes the extra one when the count is odd.
const topRow = Math.ceil(mapDomains.length / 2);
const regionCenter = (di: number) => {
  const inTop = di < topRow;
  const n = inTop ? topRow : mapDomains.length - topRow;
  const k = inTop ? di : di - topRow;
  const span = MAP.w - 200;
  return { x: 100 + (span * (k + 0.5)) / n + (inTop ? 0 : (k % 2 ? 12 : -12)), y: inTop ? 228 + (k % 2 ? -18 : 0) : 600 };
};
const cities = data.topics.map((t, i) => ({ ...t, i, x: 0, y: 0, r: Math.min(3.6 + 1.5 * Math.sqrt(t.books.length), 9.5) }));
const regions = mapDomains.map((d, di) => {
  const c = regionCenter(di);
  const members = cities.filter((t) => t.domain === d.name);
  const rows = Math.ceil(members.length / 2);
  const rand = seeded(di + 7);
  members.forEach((t, k) => {
    const col = k % 2;
    const row = Math.floor(k / 2);
    const lone = k === members.length - 1 && members.length % 2 === 1;
    t.x = c.x + (lone ? 0 : (col - 0.5) * MAP.colGap) + (row % 2 ? 14 : -14) + (rand() - 0.5) * 16;
    t.y = c.y + (row - (rows - 1) / 2) * MAP.rowGap + (rand() - 0.5) * 12;
  });
  const rx = MAP.colGap / 2 + 72;
  const ry = ((rows - 1) * MAP.rowGap) / 2 + 60;
  const phase = [rand() * 6.28, rand() * 6.28, rand() * 6.28];
  const shape = (scale: number) => {
    const pts = Array.from({ length: 40 }, (_, k) => {
      const a = (k / 40) * Math.PI * 2;
      const wobble = 1 + 0.07 * Math.sin(3 * a + phase[0]) + 0.05 * Math.sin(5 * a + phase[1]) + 0.025 * Math.sin(9 * a + phase[2]);
      return { x: c.x + Math.cos(a) * rx * wobble * scale, y: c.y + 6 + Math.sin(a) * ry * wobble * scale };
    });
    // Closed Catmull-Rom spline through the wobbly ellipse points, written as cubic Béziers.
    const p = (k: number) => pts[(k + pts.length) % pts.length];
    let dPath = `M${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)}`;
    for (let k = 0; k < pts.length; k++) {
      const [p0, p1, p2, p3] = [p(k - 1), p(k), p(k + 1), p(k + 2)];
      dPath += `C${(p1.x + (p2.x - p0.x) / 6).toFixed(1)},${(p1.y + (p2.y - p0.y) / 6).toFixed(1)} ${(p2.x - (p3.x - p1.x) / 6).toFixed(1)},${(p2.y - (p3.y - p1.y) / 6).toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
    }
    return `${dPath}Z`;
  };
  return { ...d, land: shape(1), coast: shape(1.07), coast2: shape(1.15), labelX: c.x, labelY: c.y + 6 - ry * 1.1 - 12 };
});
const roads = cities.flatMap((a) =>
  cities
    .filter((b) => b.i > a.i)
    .map((b) => ({ a, b, w: a.books.filter((x) => b.books.includes(x)).length }))
    .filter((e) => e.w >= 2 || (e.w === 1 && e.a.domain === e.b.domain))
    .map((e) => {
      const sea = e.a.domain !== e.b.domain;
      const mx = (e.a.x + e.b.x) / 2;
      const my = (e.a.y + e.b.y) / 2;
      const bend = sea ? 0.18 : 0.08;
      const cx = mx - (e.b.y - e.a.y) * bend;
      const cy = my + (e.b.x - e.a.x) * bend;
      return { ...e, sea, d: `M${e.a.x.toFixed(1)},${e.a.y.toFixed(1)}Q${cx.toFixed(1)},${cy.toFixed(1)} ${e.b.x.toFixed(1)},${e.b.y.toFixed(1)}` };
    }),
);

const cardText = (b: (typeof data.books)[number]): string | undefined =>
  b.verdict ?? b.myThoughts[0]?.text ?? b.highlights[0];

const fmtHours = (h: number) => (h >= 10 ? Math.round(h).toString() : h.toFixed(1));
const monthLabel = (m: string) => {
  const [y, mm] = m.split("-");
  return `${y} 年 ${Number(mm)} 月`;
};

const stats = [
  { value: data.totalHours.toString(), unit: "小时", label: "累计阅读" },
  { value: data.readDays.toString(), unit: "天", label: "有阅读的日子" },
  { value: data.readBooks.replace("本", ""), unit: "本", label: "读过" },
  { value: data.finishedBooks.replace("本", ""), unit: "本", label: "读完" },
  { value: data.notes.replace("条", ""), unit: "条", label: "划线和想法" },
];
---

<Layout
  title="书房 — Charles Cheng"
  description={pageDescription}
  canonicalPath="/books"
  lang="zh-CN"
  contentClass="w-full max-w-5xl mx-auto px-4 py-5 sm:px-6 lg:py-12"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Charles Cheng 的书房",
    url: new URL("/books", site.url).toString(),
    description: pageDescription,
  }}
>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/lxgwwenkaigbscreen.css" />
  <div class="bk-page">
    <header class="bk-hero">
      <p class="bk-overline">Reading · 微信读书</p>
      <h1>书房</h1>
    </header>

    <section class="bk-stats" aria-label="阅读总览">
      {stats.map((s) => (
        <div class="bk-stat">
          <p class="bk-stat-value">{s.value}<span>{s.unit}</span></p>
          <p class="bk-stat-label">{s.label}</p>
        </div>
      ))}
    </section>

    <section class="bk-section">
      <div class="bk-panel">
        <div class="bk-year-chart" role="img" aria-label="每年阅读时长柱状图">
          {data.years.map((y) => (
            <div class="bk-year-col">
              <span class="bk-year-value">{fmtHours(y.hours)}<small>h</small></span>
              <div class="bk-year-track">
                <div
                  class:list={["bk-bar", { "is-partial": y.year === currentYear }]}
                  style={`height:${Math.max((y.hours / maxYear) * 100, 1.5)}%`}
                  tabindex="0"
                  data-tip={`${y.year} 年${y.year === currentYear ? `截至 ${asOf}` : ""}｜${y.hours} 小时｜${y.days} 天在读｜读完 ${y.finished} 本`}
                  aria-label={`${y.year} 年 ${y.hours} 小时，${y.days} 天在读，读完 ${y.finished} 本`}
                ></div>
              </div>
              <span class="bk-axis-label">{y.year}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bk-section">
      <div class="bk-panel">
        <div class="bk-month-chart" role="img" aria-label="每月阅读时长柱状图">
          {months.map((m) => (
            <div class="bk-month-col">
              <div
                class:list={["bk-bar", { "is-peak": m.month === peakMonth.month }]}
                style={`height:${Math.max((m.hours / maxMonth) * 100, m.hours > 0 ? 2 : 0.6)}%`}
                tabindex="0"
                data-tip={`${monthLabel(m.month)}｜${m.hours} 小时`}
                aria-label={`${monthLabel(m.month)} ${m.hours} 小时`}
              ></div>
            </div>
          ))}
        </div>
        <div class="bk-month-axis">
          {months.map((m) => (
            <span>{m.month.endsWith("-01") ? m.month.slice(0, 4) : ""}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="bk-section">
        <div class="bk-panel">
          <div class="bk-hour-chart" role="img" aria-label="按小时的累计阅读时长">
            {data.hourly.map((h) => (
              <div class="bk-hour-col">
                <div
                  class:list={["bk-bar", { "is-peak": h.hour === peakHour.hour }]}
                  style={`height:${Math.max((h.hours / maxHour) * 100, 1.5)}%`}
                  tabindex="0"
                  data-tip={`${h.hour}:00–${h.hour + 1}:00｜累计 ${h.hours} 小时`}
                  aria-label={`${h.hour} 点 累计 ${h.hours} 小时`}
                ></div>
              </div>
            ))}
          </div>
          <div class="bk-hour-axis">
            {data.hourly.map((h) => (
              <span>{h.hour % 6 === 0 ? `${h.hour} 点` : ""}</span>
            ))}
          </div>
        </div>
      </section>

    <div class="bk-two">
      <section class="bk-section">
        <div class="bk-panel bk-radar">
          <svg viewBox="0 0 370 272" role="img" aria-label={`阅读偏好六维图：${radarCats.map((c) => `${c.name} ${c.hours} 小时`).join("，")}`}>
            {[0.25, 0.5, 0.75, 1].map((f) => (
              <polygon class="bk-radar-ring" points={radarRing(f)} />
            ))}
            {radarCats.map((_, i) => {
              const p = radarPoint(i, 1);
              return <line class="bk-radar-axis" x1={RADAR.cx} y1={RADAR.cy} x2={p.x} y2={p.y} />;
            })}
            <polygon class="bk-radar-shape" points={radarVerts.map((v) => `${v.x.toFixed(1)},${v.y.toFixed(1)}`).join(" ")} />
            {radarVerts.map((v) => (
              <g class="bk-radar-pt" tabindex="0" data-tip={`${v.name}｜${v.hours} 小时｜${v.count} 本`}>
                <circle class="bk-radar-hit" cx={v.x} cy={v.y} r="13" />
                <circle class="bk-radar-dot" cx={v.x} cy={v.y} r="4.5" />
              </g>
            ))}
            {radarLabels.map((l) => (
              <text class="bk-radar-label" x={l.x} y={l.y} text-anchor={l.anchor} dominant-baseline="middle">
                <tspan>{l.name}</tspan>
                <tspan class="bk-radar-value" dx="5">{l.hours}h</tspan>
              </text>
            ))}
          </svg>
        </div>
      </section>

      <section class="bk-section">
        <div class="bk-panel bk-cats">
          {data.categories.map((c, i) => (
            <div class="bk-cat-row" tabindex="0" data-tip={`${c.name}｜${c.hours} 小时｜${c.count} 本`}>
              <span class="bk-cat-name">{c.name}</span>
              <div class="bk-cat-track">
                <div class:list={["bk-cat-bar", { "is-peak": i === 0 }]} style={`width:${Math.max((c.hours / maxCat) * 100, 2)}%`}></div>
              </div>
              <span class="bk-cat-value">{c.hours}h · {c.count} 本</span>
            </div>
          ))}
        </div>
      </section>
    </div>

    <section class="bk-atlas" aria-label="知识地图">
      <div class="bk-map-scroll">
        <svg class="bk-map" viewBox={`0 0 ${MAP.w} ${MAP.h}`} role="group" aria-label={`知识地图：${mapDomains.map((d) => `${d.name} ${d.topics} 个主题`).join("，")}`}>
          <defs>
            <pattern id="bk-sea" width="46" height="22" patternUnits="userSpaceOnUse">
              <path d="M4 13q5-5 10 0t10 0" class="bk-wave" />
            </pattern>
          </defs>
          <defs>
            <clipPath id="bk-map-clip">
              <rect x="18" y="18" width={MAP.w - 36} height={MAP.h - 36} />
            </clipPath>
          </defs>
          <rect class="bk-map-sea" x="10" y="10" width={MAP.w - 20} height={MAP.h - 20} />
          <rect class="bk-map-frame" x="10" y="10" width={MAP.w - 20} height={MAP.h - 20} />
          <rect class="bk-map-frame is-inner" x="17" y="17" width={MAP.w - 34} height={MAP.h - 34} />
          {regions.map((r) => (
            <g class="bk-region" clip-path="url(#bk-map-clip)">
              <path class="bk-coast is-far" d={r.coast2} />
              <path class="bk-coast" d={r.coast} />
              <path class="bk-land" d={r.land} />
            </g>
          ))}
          {roads.map((e) => (
            <path
              class:list={["bk-road", { "is-sea": e.sea }]}
              d={e.d}
              data-a={e.a.i}
              data-b={e.b.i}
              style={`stroke-width:${Math.min(0.8 + 0.55 * e.w, 3.4).toFixed(2)}`}
            />
          ))}
          {regions.map((r) => (
            <text class="bk-region-label" x={r.labelX} y={r.labelY} text-anchor="middle">
              {r.name}
              <tspan class="bk-region-count" dx="8">{r.books} 本</tspan>
            </text>
          ))}
          {cities.map((t) => (
            <g
              class="bk-city"
              data-topic={t.i}
              tabindex="0"
              role="button"
              aria-label={`${t.name}，${t.books.length} 本书`}
              data-tip={`${t.name}｜${t.books.length} 本书｜≥ ${t.hours} 小时`}
            >
              <circle class="bk-city-hit" cx={t.x} cy={t.y} r="20" />
              <circle class="bk-city-ring" cx={t.x} cy={t.y} r={t.r} />
              <circle class="bk-city-dot" cx={t.x} cy={t.y} r="1.9" />
              <text class="bk-city-label" x={t.x} y={t.y + t.r + 15} text-anchor="middle">{t.name}</text>
            </g>
          ))}
          <g class="bk-compass" transform={`translate(78 ${MAP.h - 82})`}>
            <circle r="30" class="bk-compass-ring" />
            <circle r="24" class="bk-compass-ring is-thin" />
            <path d="M0 -40 L6 0 L0 40 L-6 0 Z" class="bk-compass-needle" />
            <path d="M-40 0 L0 5 L40 0 L0 -5 Z" class="bk-compass-needle is-light" />
            <text y="-46" text-anchor="middle" class="bk-compass-n">北</text>
          </g>
          <g class="bk-legend" transform={`translate(${MAP.w - 200} ${MAP.h - 62})`}>
            <path d="M0 0h34" class="bk-road" style="stroke-width:2" />
            <text x="44" y="4">同领域共读的书</text>
            <path d="M0 22h34" class="bk-road is-sea" style="stroke-width:2" />
            <text x="44" y="26">跨领域共读的书</text>
          </g>
        </svg>
      </div>

      <ol class="bk-topics">
        {cities.map((t) => (
          <li>
            <button class="bk-topic" type="button" data-topic={t.i} aria-haspopup="dialog">
              <span class="bk-topic-domain">{t.domain}</span>
              <span class="bk-topic-name">{t.name}</span>
              {t.oneLiner && <span class="bk-topic-line">{t.oneLiner}</span>}
              <span class="bk-book-meta">
                <span>{t.books.length} 本书</span>
                <span>≥ {t.hours} h</span>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="bk-picks">
      <div class="bk-tools">
        <div class="bk-sort" role="group" aria-label="排序方式">
          <button type="button" class="bk-sort-btn is-active" data-sort="default" aria-pressed="true">推荐优先</button>
          <button type="button" class="bk-sort-btn" data-sort="recent" aria-pressed="false">最近阅读</button>
        </div>
        <button type="button" class="bk-reco-toggle" aria-pressed="false">
          只看推荐<span>{data.books.filter((b) => b.recommended).length}</span>
        </button>
      </div>
      <div class="bk-filter" role="tablist" aria-label="按领域筛选">
        <button type="button" class="bk-chip-btn is-active" data-cat="all" role="tab" aria-selected="true">全部<span>{data.books.length}</span></button>
        {data.domains.map((d) => (
          <button type="button" class="bk-chip-btn" data-cat={d.name} role="tab" aria-selected="false">
            {d.name}<span>{d.books}</span>
          </button>
        ))}
      </div>

      <ol class="bk-grid">
        {data.books.map((b, i) => (
          <li data-cat={b.domains.join("|")} data-order={i} data-read={b.readAt ?? ""} data-reco={b.recommended ? "1" : undefined}>
            <button class="bk-book" type="button" data-idx={i} aria-haspopup="dialog">
              <span class="bk-shelf">
                {b.recommended && <span class="bk-reco">推荐</span>}
                <img
                  src={b.cover}
                  alt={`《${b.title}》封面`}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  width="120"
                  height="172"
                />
              </span>
              <span class="bk-book-body">
                <span class="bk-book-title">{b.title}</span>
                <span class="bk-book-author">{b.author}</span>
                {cardText(b) && (
                  <span class:list={["bk-book-verdict", { "is-quote": !b.verdict && b.myThoughts.length === 0 && !cardText(b)?.startsWith("“") }]}>
                    {cardText(b)}
                  </span>
                )}
                <span class="bk-book-meta">
                  <span>{b.finished ? `${b.finished.slice(0, 7).replace("-", ".")} 读完` : `读到 ${b.progress}%`}</span>
                  {b.hours > 0 && <span>≥ {b.hours} h</span>}
                  <span>{b.domains[0]}</span>
                </span>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <dialog class="bk-dialog" id="bk-dialog" aria-labelledby="bk-dialog-title" data-version={data.generatedAt}>
      <div class="bk-dialog-inner">
        <button class="bk-close" type="button" data-close aria-label="关闭">×</button>
        <div class="bk-dialog-body" id="bk-dialog-body"></div>
      </div>
    </dialog>

    <footer class="bk-footnote">
      数据于 {data.generatedAt} 从微信读书拉取。单本书的阅读时长按每月阅读前 10 名累加，只能算下限。想法保留原话。
    </footer>
  </div>

  <div class="bk-tip" id="bk-tip" role="tooltip" hidden></div>
</Layout>

<script>
  const tip = document.getElementById("bk-tip");
  if (tip) {
    const show = (el: HTMLElement | SVGElement, x: number, y: number) => {
      tip.textContent = el.dataset.tip ?? "";
      tip.hidden = false;
      const r = tip.getBoundingClientRect();
      const left = Math.min(Math.max(x - r.width / 2, 8), window.innerWidth - r.width - 8);
      tip.style.left = `${left}px`;
      tip.style.top = `${Math.max(y - r.height - 12, 8)}px`;
    };
    const hide = () => {
      tip.hidden = true;
    };
    document.querySelectorAll<HTMLElement | SVGElement>("[data-tip]").forEach((el) => {
      el.addEventListener("pointermove", (e) => show(el, e.clientX, e.clientY));
      el.addEventListener("pointerleave", hide);
      el.addEventListener("focus", () => {
        const r = el.getBoundingClientRect();
        show(el, r.left + r.width / 2, r.top);
      });
      el.addEventListener("blur", hide);
    });
  }

  const grid = document.querySelector<HTMLOListElement>(".bk-grid");
  const sortBtns = document.querySelectorAll<HTMLButtonElement>(".bk-sort-btn");
  sortBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!grid) return;
      const mode = btn.dataset.sort;
      sortBtns.forEach((b) => {
        const on = b === btn;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      const items = [...grid.children] as HTMLElement[];
      items.sort((a, b) =>
        mode === "recent"
          ? (b.dataset.read ?? "").localeCompare(a.dataset.read ?? "") || Number(a.dataset.order) - Number(b.dataset.order)
          : Number(a.dataset.order) - Number(b.dataset.order),
      );
      grid.append(...items);
    });
  });

  let activeCat = "all";
  let recoOnly = false;
  const applyFilter = () => {
    document.querySelectorAll<HTMLElement>(".bk-grid li").forEach((li) => {
      const inDomain = activeCat === "all" || (li.dataset.cat ?? "").split("|").includes(activeCat);
      li.hidden = !inDomain || (recoOnly && !li.dataset.reco);
    });
  };

  const chips = document.querySelectorAll<HTMLButtonElement>(".bk-chip-btn");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeCat = chip.dataset.cat ?? "all";
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle("is-active", on);
        c.setAttribute("aria-selected", String(on));
      });
      applyFilter();
    });
  });

  const recoToggle = document.querySelector<HTMLButtonElement>(".bk-reco-toggle");
  recoToggle?.addEventListener("click", () => {
    recoOnly = !recoOnly;
    recoToggle.classList.toggle("is-active", recoOnly);
    recoToggle.setAttribute("aria-pressed", String(recoOnly));
    applyFilter();
  });

  type Book = {
    title: string; author: string; cover: string; rating: number; progress: number;
    finished: string | null; hours: number; marks: number; recommended: boolean; verdict: string | null;
    myThoughts: { text: string; quote: string }[]; quotes: string[]; highlights: string[]; cards: string[]; link: string | null;
    domains: string[]; topics: number[];
  };
  type Topic = {
    name: string; domain: string; oneLiner: string; hours: number; books: number[];
    viewpoints: { claim: string; text: string; books: { title: string; idx: number | null }[] }[];
    thoughts: { text: string; quote: string; idx: number }[];
    highlights: { text: string; idx: number }[];
  };
  type Detail = { books: Book[] };
  const dlg = document.getElementById("bk-dialog") as HTMLDialogElement | null;
  const body = document.getElementById("bk-dialog-body");
  // Details load on first open. A failed request is forgotten so the next click retries.
  const version = dlg?.dataset.version ?? "";
  const cache = new Map<string, Promise<unknown>>();
  const load = <T,>(path: string): Promise<T> => {
    if (!cache.has(path)) {
      const req = fetch(`${path}?v=${version}`).then((r) => {
        if (!r.ok) throw new Error(`${path} ${r.status}`);
        return r.json();
      });
      req.catch(() => cache.delete(path));
      cache.set(path, req);
    }
    return cache.get(path) as Promise<T>;
  };
  const loadDetail = async (): Promise<Detail> => ({ books: await load<Book[]>("/books/data.json") });
  const loadTopics = () => load<Topic[]>("/books/topics.json");
  const topicNames = new Map(
    [...document.querySelectorAll<HTMLElement>(".bk-topic")].map((n) => [Number(n.dataset.topic), n.querySelector(".bk-topic-name")?.textContent ?? ""]),
  );
  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  // Small inline button that swaps the dialog to another book or topic.
  const jump = (label: string, kind: "book" | "topic", idx: number, cls = "bk-jump") => {
    const btn = el("button", cls, label) as HTMLButtonElement;
    btn.type = "button";
    btn.addEventListener("click", () => (kind === "book" ? openBook(idx) : openTopic(idx)));
    return btn;
  };
  const source = (d: Detail, idx: number) => {
    const cap = el("span", "bk-src");
    cap.append(jump(`《${d.books[idx].title}》`, "book", idx));
    return cap;
  };
  const show = () => {
    if (!dlg) return;
    if (!dlg.open) dlg.showModal();
    dlg.scrollTop = 0;
    // Content was just replaced, so put focus on the new heading instead of losing it.
    const title = document.getElementById("bk-dialog-title");
    if (title) {
      title.tabIndex = -1;
      title.focus({ preventScroll: true });
    }
  };
  const renderTopic = (d: Detail, t: Topic) => {
    if (!body) return;
    body.replaceChildren();
    const head = el("div", "bk-topic-head");
    head.append(el("p", "bk-dialog-score", `${t.domain} · ${t.books.length} 本书 · 至少 ${t.hours} 小时`));
    const h3 = el("h3", undefined, t.name); h3.id = "bk-dialog-title"; head.append(h3);
    body.append(head);
    if (t.oneLiner) body.append(el("p", "bk-dialog-verdict", t.oneLiner));
    if (t.viewpoints.length) {
      const ol = el("ol", "bk-views");
      t.viewpoints.forEach((v) => {
        const li = el("li");
        li.append(el("strong", undefined, v.claim));
        if (v.text) li.append(el("p", undefined, v.text));
        if (v.books.length) {
          const from = el("span", "bk-src");
          v.books.forEach((b) => from.append(b.idx === null ? el("span", "bk-src-plain", `《${b.title}》`) : jump(`《${b.title}》`, "book", b.idx)));
          li.append(from);
        }
        ol.append(li);
      });
      body.append(ol);
    }
    if (t.thoughts.length) {
      const notes = el("div", "bk-notes");
      t.thoughts.forEach((x) => {
        const fig = el("figure", "bk-note");
        fig.append(el("blockquote", undefined, x.quote));
        const cap = el("figcaption"); cap.append(el("span", undefined, "我"), document.createTextNode(x.text), source(d, x.idx));
        fig.append(cap); notes.append(fig);
      });
      body.append(notes);
    }
    if (t.highlights.length) {
      const ol = el("ol", "bk-marks");
      t.highlights.forEach((h) => {
        const li = el("li", undefined, h.text);
        li.append(source(d, h.idx));
        ol.append(li);
      });
      body.append(ol);
    }
    const shelf = el("div", "bk-topic-books");
    t.books.forEach((i) => {
      const b = d.books[i];
      const btn = jump("", "book", i, "bk-mini") as HTMLButtonElement;
      btn.setAttribute("aria-label", `《${b.title}》`);
      btn.title = b.title;
      const img = el("img") as HTMLImageElement;
      img.src = b.cover; img.alt = ""; img.width = 52; img.height = 74; img.loading = "lazy"; img.referrerPolicy = "no-referrer";
      btn.append(img); shelf.append(btn);
    });
    body.append(shelf);
  };
  const openBook = async (i: number) => {
    const d = await loadDetail();
    const b = d.books[i];
    if (!b) return;
    render(d, b);
    show();
  };
  const openTopic = async (i: number) => {
    const [d, topics] = await Promise.all([loadDetail(), loadTopics()]);
    const t = topics[i];
    if (!t) return;
    renderTopic(d, t);
    show();
  };
  const render = (d: Detail, b: Book) => {
    if (!body) return;
    body.replaceChildren();
    const head = el("div", "bk-dialog-head");
    const img = el("img") as HTMLImageElement;
    img.src = b.cover; img.alt = ""; img.width = 84; img.height = 120; img.referrerPolicy = "no-referrer";
    const info = el("div");
    info.append(el("p", "bk-dialog-score", b.recommended ? `推荐 · ${b.domains.join(" · ")}` : b.domains.join(" · ")));
    const h3 = el("h3", undefined, `《${b.title}》`); h3.id = "bk-dialog-title"; info.append(h3);
    info.append(el("p", "bk-book-author", b.author));
    const pills = el("ul", "bk-pills");
    [b.finished ? `读完于 ${b.finished}` : `读到 ${b.progress}%`, b.hours > 0 ? `至少读了 ${b.hours} 小时` : "", `划线 ${b.marks}`, b.rating ? `微信读书 ${b.rating}%` : ""]
      .filter(Boolean).forEach((p) => pills.append(el("li", undefined, p)));
    info.append(pills); head.append(img, info); body.append(head);
    if (b.topics.length) {
      const row = el("div", "bk-topic-row");
      row.append(el("span", undefined, "归入的主题"));
      b.topics.forEach((ti) => row.append(jump(topicNames.get(ti) ?? "", "topic", ti, "bk-jump is-topic")));
      body.append(row);
    }
    if (b.verdict) body.append(el("p", "bk-dialog-verdict", b.verdict));
    if (b.myThoughts.length) {
      const notes = el("div", "bk-notes");
      b.myThoughts.forEach((t) => {
        const fig = el("figure", "bk-note");
        fig.append(el("blockquote", undefined, t.quote));
        const cap = el("figcaption"); cap.append(el("span", undefined, "我"), document.createTextNode(t.text));
        fig.append(cap); notes.append(fig);
      });
      body.append(notes);
    }
    const marks = [...b.quotes, ...b.highlights];
    if (marks.length) {
      const ol = el("ol", "bk-marks");
      marks.forEach((m) => ol.append(el("li", undefined, m)));
      body.append(ol);
    }
    if (b.cards.length || b.link) {
      const foot = el("div", "bk-dialog-foot");
      const chips = el("div", "bk-chips");
      b.cards.forEach((c) => chips.append(el("span", "bk-chip", c)));
      foot.append(chips);
      if (b.link) {
        const a = el("a", "bk-link", "在微信读书打开 →") as HTMLAnchorElement;
        a.href = b.link; a.target = "_blank"; a.rel = "noopener noreferrer"; foot.append(a);
      }
      body.append(foot);
    }
  };
  document.querySelectorAll<HTMLButtonElement>(".bk-book").forEach((btn) => {
    btn.addEventListener("click", () => openBook(Number(btn.dataset.idx)));
  });
  document.querySelectorAll<HTMLElement | SVGElement>("[data-topic]").forEach((node) => {
    node.addEventListener("click", () => openTopic(Number(node.dataset.topic)));
    node.addEventListener("keydown", (e) => {
      if (node instanceof SVGElement && ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ")) {
        e.preventDefault();
        openTopic(Number(node.dataset.topic));
      }
    });
  });

  // Hovering a city lights up its roads and the cities they reach; everything else fades.
  const map = document.querySelector<SVGSVGElement>(".bk-map");
  if (map) {
    const roads = [...map.querySelectorAll<SVGPathElement>(".bk-road[data-a]")];
    const cities = [...map.querySelectorAll<SVGGElement>(".bk-city")];
    let hovered: string | null = null;
    let focused: string | null = null;
    const focus = (i: string | null) => {
      map.classList.toggle("is-focus", i !== null);
      const linked = new Set(i === null ? [] : [i]);
      roads.forEach((r) => {
        const on = i !== null && (r.dataset.a === i || r.dataset.b === i);
        r.classList.toggle("is-on", on);
        if (on) linked.add(r.dataset.a === i ? r.dataset.b! : r.dataset.a!);
      });
      cities.forEach((c) => c.classList.toggle("is-on", linked.has(c.dataset.topic!)));
    };
    cities.forEach((c) => {
      const sync = () => focus(hovered ?? focused);
      c.addEventListener("pointerenter", () => ((hovered = c.dataset.topic!), sync()));
      c.addEventListener("pointerleave", () => ((hovered = null), sync()));
      c.addEventListener("focus", () => ((focused = c.dataset.topic!), sync()));
      c.addEventListener("blur", () => ((focused = null), sync()));
    });
  }
  if (dlg) {
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.querySelector("[data-close]")?.addEventListener("click", () => dlg.close());
  }
</script>

